{
  "crons": [
    {
      "path": "/api/email-lembretes",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/email-pesquisa",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "api/email-lembretes.js": {
      "maxDuration": 60
    },
    "api/email-admin.js": {
      "maxDuration": 60
    },
    "api/avisos.js": {
      "maxDuration": 60
    },
    "api/email-pesquisa.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/e/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|linkedinbot|twitterbot|slackbot|telegrambot|discordbot|skypeuripreview|googlebot|bingbot|crawler|spider).*"
        }
      ],
      "destination": "/api/edicao?slug=:slug"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ]
}