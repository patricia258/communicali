{
  "crons": [
    {
      "path": "/api/email-lembretes",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/email-pesquisa",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/email-consumo",
      "schedule": "0 12 12 11 *"
    },
    {
      "path": "/api/email-consumo",
      "schedule": "30 12 12 11 *"
    }
  ],
  "functions": {
    "api/email-lembretes.js": {
      "maxDuration": 60
    },
    "api/email-admin.js": {
      "maxDuration": 60
    },
    "api/avisos.js": {
      "maxDuration": 60
    },
    "api/email-pesquisa.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/e/:slug",
      "destination": "/api/edicao?slug=:slug"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
