    "tipo": "texto"
  },
  {
    "id": "texto_017",
    "secao": "agenda",
    "padrao": "Em breve",
    "tipo": "texto"
  },
  {
    "id": "texto_018",
    "secao": "agenda",
    "padrao": "DATA A DEFINIR",
    "tipo": "texto"
  },
  {
    "id": "texto_019",
    "secao": "agenda",
    "padrao": "Próximo encontro",
    "tipo": "texto"
  },
  {
    "id": "texto_020",
    "secao": "agenda",
    "padrao": "Curitiba e região",
    "tipo": "texto"
  },
  {
    "id": "texto_021",
