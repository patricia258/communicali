    "padrao": "A definir",
    "tipo": "texto"
  },
  {
    "id": "texto_022",
    "secao": "agenda",
    "padrao": "Valor divulgado com a edição",
    "tipo": "texto"
  },
  {
    "id": "texto_023",
    "secao": "embaixadores",
    "padrao": "EMBAIXADORES",
    "tipo": "texto"
  },
  {
    "id": "texto_024",
    "secao": "embaixadores",
    "padrao": "Faça parte desse ecossistema.",
    "tipo": "texto"
  },
  {
    "id": "texto_025",
    "secao": "embaixadores",
    "padrao": "Arraste",
