    "padrao": "Ver como foi",
    "tipo": "texto"
  },
  {
    "id": "texto_014",
    "secao": "agenda",
    "padrao": "Garantir minha vaga",
    "tipo": "texto"
  },
  {
    "id": "texto_015",
    "secao": "agenda",
    "padrao": "Entrar no grupo",
    "tipo": "texto"
  },
  {
    "id": "texto_016",
